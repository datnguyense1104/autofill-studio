# Copy to .env and fill in. Never commit .env.

# Supabase > Connect > Session pooler (URI form). Percent-encode special characters in the password.
DATABASE_URL=

# Supabase > Project Settings > API: Project URL and the service_role (secret) key.
# The app creates a private bucket by itself.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=autofill
# supabase (default when SUPABASE_URL is set) | disk (development only)
FILE_STORE=
MAX_FILE_MB=50

# AI. Leave OPENAI_BASE_URL empty for api.openai.com; set it for Azure OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=

# Source documents: how many characters of text go into a prompt (longer files are cut, with a warning).
MAX_SOURCE_CHARS=120000
# LibreOffice for .doc/.xls (set in the Docker image; leave empty to look in the usual places).
SOFFICE_PATH=

# The account registered with this email is the administrator (active at once, can activate others).
ADMIN_EMAIL=

# Background workers in this container (0 = none).
WORKERS=2

# Path the app is published under: /auto-fill for https://ntdat.qzz.io/auto-fill/ (empty = site root).
BASE_PATH=/auto-fill

# Docker image to run (docker-compose only). Empty = build on this machine.
# After GitHub Actions has built it: ghcr.io/<owner>/<repo>:latest
AUTOFILL_IMAGE=

# Cloudflare Tunnel token: only when the tunnel runs as the compose container
# (docker compose --profile tunnel up -d). Leave empty when cloudflared is installed as a Windows service.
CLOUDFLARE_TUNNEL_TOKEN=
